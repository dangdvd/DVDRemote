{
  "name": "dvd-remote",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "buffer": "^6.0.3",
    "expo": "~58.0.21",
    "expo-build-properties": "~58.0.11",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-haptics": "~58.0.7",
    "expo-network": "~58.0.4",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "node-forge": "^1.4.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.9",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-udp": "^4.1.7",
    "react-native-zeroconf": "^0.17.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/react": "~19.3.0",
    "@types/ws": "^8.18.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "ws": "^8.22.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/__tests__/shims/react-native.ts",
      "^react-native-tcp-socket$": "<rootDir>/__tests__/shims/tcp-socket.ts",
      "^expo-crypto$": "<rootDir>/__tests__/shims/expo-crypto.ts",
      "^@react-native-async-storage/async-storage$": "<rootDir>/__tests__/shims/async-storage.ts",
      "^react-native-quick-crypto$": "<rootDir>/__tests__/shims/quick-crypto.ts"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  }
}
